# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — PONCHO DIGITAL (TP_Lab_Backend_2026)
# Copiar este archivo a .env (desarrollo) y .env.test (pruebas aisladas)
# Reemplazar todos los valores de ejemplo (<PLACEHOLDER>) por valores reales.
# ==============================================================================

# 1. Base de Datos PostgreSQL (Desarrollo)
DATABASE_URL="postgresql://<USUARIO_PG>:<PASSWORD_PG>@localhost:5432/poncho_digital?schema=public"

# 2. Clave secreta obligatoria para firma y verificación de tokens JWT (HS256)
JWT_SECRET="<REEMPLAZAR_POR_SECRETO_JWT_SEGURO_DE_AL_MENOS_32_CARACTERES>"

# 3. Puerto HTTP y Entorno de Ejecución (development | production | test)
PORT=3000
NODE_ENV="development"

# 4. Credenciales de Cuentas de Demostración para Seed (prisma/seed.js) y Postman
SEED_ADMIN_EMAIL="admin@ponchodigital.gob.ar"
SEED_ADMIN_PASSWORD="<REEMPLAZAR_POR_PASSWORD_ADMIN_DEMO>"
SEED_ARTESANO_EMAIL="artesano.belen@ponchodigital.gob.ar"
SEED_ARTESANO_PASSWORD="<REEMPLAZAR_POR_PASSWORD_ARTESANO_DEMO>"

# ==============================================================================
# EJEMPLO DE CONFIGURACIÓN PARA .env.test (Base de pruebas aislada *_test)
# ==============================================================================
# NODE_ENV="test"
# DATABASE_URL="postgresql://<USUARIO_PG>:<PASSWORD_PG>@localhost:5432/poncho_digital_test?schema=public"
# JWT_SECRET="<REEMPLAZAR_POR_SECRETO_JWT_DE_PRUEBAS>"
# PORT=3001
# SEED_ADMIN_EMAIL="admin@ponchodigital.gob.ar"
# SEED_ADMIN_PASSWORD="<REEMPLAZAR_POR_PASSWORD_ADMIN_TEST>"
# SEED_ARTESANO_EMAIL="artesano.belen@ponchodigital.gob.ar"
# SEED_ARTESANO_PASSWORD="<REEMPLAZAR_POR_PASSWORD_ARTESANO_TEST>"
