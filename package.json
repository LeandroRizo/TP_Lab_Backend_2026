{
  "name": "tp_lab_backend_2026",
  "version": "1.0.0",
  "description": "Trabajo de Laboratorio Backend 2026",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/app.js",
    "dev": "node --env-file=.env --watch src/app.js",
    "docs": "node generar-docs.js",
    "seed": "node --env-file=.env prisma/seed.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 tests/**/*.test.js",
    "test:unit": "node --env-file=.env.test --test tests/00_esquemas_unitarios.test.js",
    "test:integracion": "node --env-file=.env.test --test --test-concurrency=1 tests/01_*.test.js tests/02_*.test.js tests/03_*.test.js tests/04_*.test.js tests/05_*.test.js tests/06_*.test.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeandroRizo/TP_Lab_Backend_2026.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LeandroRizo/TP_Lab_Backend_2026/issues"
  },
  "homepage": {
    "url": "https://github.com/LeandroRizo/TP_Lab_Backend_2026#readme"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^6.12.0",
    "swagger-autogen": "^2.23.7"
  }
}
