            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADA\",\n  \"observaciones\": \"Cumple con todos los requisitos de calidad y documentación\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/solicitudes/2/resolver", "host": ["{{baseUrl}}"], "path": ["api", "solicitudes", "2", "resolver"] }
          }
        },
        {
          "name": "PUT /api/solicitudes/:id/resolver (Solicitar modificación - No habilita)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"MODIFICACION\",\n  \"observaciones\": \"Adjuntar fotografías adicionales del proceso en telar\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/solicitudes/2/resolver", "host": ["{{baseUrl}}"], "path": ["api", "solicitudes", "2", "resolver"] }
          }
        },
