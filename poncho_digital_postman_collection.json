          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Rosa\",\n  \"apellido\": \"Gómez\",\n  \"email\": \"rosa.gomez@ponchodigital.gob.ar\",\n  \"password\": \"<INGRESAR_PASSWORD_POSTULANTE>\",\n  \"dni\": \"35123999\",\n  \"telefono\": \"3834112233\",\n  \"direccion\": \"San Martín 450\",\n  \"descripcion\": \"Tejedora tradicional de vicuña y llama\",\n  \"instagram\": \"@rosagomez.tejidos\",\n  \"id_localidad\": 1,\n  \"id_rubro\": 1,\n  \"observaciones\": \"Primera participación en la Fiesta del Poncho\"\n}"
