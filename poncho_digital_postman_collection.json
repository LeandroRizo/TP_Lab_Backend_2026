        {
          "name": "GET /api/estadisticas/tendencias (Estadísticas públicas de búsqueda)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/estadisticas/tendencias", "host": ["{{baseUrl}}"], "path": ["api", "estadisticas", "tendencias"] }
          }
        }
      ]
    }
  ]
}
