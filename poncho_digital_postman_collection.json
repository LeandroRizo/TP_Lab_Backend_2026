          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reportes", "host": ["{{baseUrl}}"], "path": ["api", "reportes"] }
          }
        },
        {
          "name": "GET /api/reportes/stands-ocupacion (Ocupación de stands - Solo ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reportes/stands-ocupacion", "host": ["{{baseUrl}}"], "path": ["api", "reportes", "stands-ocupacion"] }
          }
