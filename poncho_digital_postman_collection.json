{
  "info": {
    "name": "Poncho Digital - API Backend 2026",
    "_postman_id": "c1f7a0b5-4b42-4f33-8a3b-9c71a3983d99",
    "description": "Colección oficial completa para el backend Poncho Digital (TP_Lab_Backend_2026 - UNCa). Configurá las variables de colección SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD, SEED_ARTESANO_EMAIL y SEED_ARTESANO_PASSWORD con los mismos valores definidos en tu archivo .env. Los endpoints de Login guardan automáticamente los tokens JWT en las variables adminToken y artesanoToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "SEED_ADMIN_EMAIL", "value": "admin@ponchodigital.gob.ar", "type": "string" },
    { "key": "SEED_ADMIN_PASSWORD", "value": "<CONFIGURAR_SEED_ADMIN_PASSWORD>", "type": "string" },
    { "key": "SEED_ARTESANO_EMAIL", "value": "artesano.belen@ponchodigital.gob.ar", "type": "string" },
    { "key": "SEED_ARTESANO_PASSWORD", "value": "<CONFIGURAR_SEED_ARTESANO_PASSWORD>", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "artesanoToken", "value": "", "type": "string" },
    { "key": "postulanteToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Autenticación y Perfil",
      "item": [
        {
          "name": "POST /api/auth/register (Registro público)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Demo\",\n  \"email\": \"demo_usuario@ponchodigital.gob.ar\",\n  \"password\": \"<INGRESAR_PASSWORD_DEMO>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "POST /api/auth/login (Login Administrador - Guarda adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData && jsonData.token) {",
                  "        pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{SEED_ADMIN_EMAIL}}\",\n  \"password\": \"{{SEED_ADMIN_PASSWORD}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "POST /api/auth/login (Login Artesano - Guarda artesanoToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData && jsonData.token) {",
                  "        pm.collectionVariables.set('artesanoToken', jsonData.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{SEED_ARTESANO_EMAIL}}\",\n  \"password\": \"{{SEED_ARTESANO_PASSWORD}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "GET /api/auth/me (Perfil de cuenta autenticada)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "POST /api/auth/logout (Revocación selectiva de JWT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
